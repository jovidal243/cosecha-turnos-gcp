# Copie este archivo como infra/variables.env y ajuste los valores.
PROJECT_ID=cosecha-turnos-uao          # ID del proyecto en Google Cloud
REGION=us-central1                     # región con capa gratuita de Cloud Run y Cloud Storage
AR_REPO=cosecha                        # repositorio de imágenes en Artifact Registry
BUCKET=${PROJECT_ID}-cosecha-turnos    # bucket de Cloud Storage (nombre global único)
BQ_DATASET=cosecha_turnos
GEMINI_MODEL=gemini-3.8-flash          # modelo de Vertex AI (ver docs/costos.md)
GEMINI_LOCATION=global
BILLING_ACCOUNT=                       # opcional: ID de cuenta de facturación para crear el presupuesto
PRESUPUESTO_USD=20
ALERT_EMAIL=                           # correo que recibe las alertas de Cloud Monitoring (paso 05)
